<mxfile><diagram name="Week 3 pipeline"><mxGraphModel dx="1500" dy="800" grid="0" pageWidth="1520" pageHeight="800"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="SkillAlign-RAG Week 3: executed V1 data pipeline (Pathway A, two document branches)" style="whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1460" height="44" as="geometry"/></mxCell><mxCell id="h0" value="SOURCE" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#E8EEF4;strokeColor=#7A8CA0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="220" height="34" as="geometry"/></mxCell><mxCell id="h1" value="INGEST" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#E8EEF4;strokeColor=#7A8CA0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="278" y="70" width="220" height="34" as="geometry"/></mxCell><mxCell id="h2" value="INSPECT" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#E8EEF4;strokeColor=#7A8CA0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="526" y="70" width="220" height="34" as="geometry"/></mxCell><mxCell id="h3" value="PREPARE / TRANSFORM" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#E8EEF4;strokeColor=#7A8CA0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="774" y="70" width="220" height="34" as="geometry"/></mxCell><mxCell id="h4" value="VALIDATE OUTPUT" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#E8EEF4;strokeColor=#7A8CA0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1022" y="70" width="220" height="34" as="geometry"/></mxCell><mxCell id="h5" value="RECORD LINEAGE" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#E8EEF4;strokeColor=#7A8CA0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1270" y="70" width="220" height="34" as="geometry"/></mxCell><mxCell id="c0" value="Data Source 1: course files&#10;data/courses/&#10;38 documents, 3 courses&#10;CLO / Taught / Assessed&#10;PDF, PPTX, DOCX&#10;FR1, FR3, RAI1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="118" width="220" height="176" as="geometry"/></mxCell><mxCell id="c1" value="Integrity check:&#10;PDF end marker, Office archive&#10;Office files to PDF&#10;(valid conversions reused)&#10;Native text + RapidOCR&#10;Document cache disabled" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="278" y="118" width="220" height="176" as="geometry"/></mxCell><mxCell id="c2" value="1,407 pages, counted per file&#10;Formats and evidence levels&#10;Folder availability&#10;OCR and empty-page counts&#10;Redaction event counts&#10;Gap: SAIA2113 CLO folder empty" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="526" y="118" width="220" height="176" as="geometry"/></mxCell><mxCell id="c3" value="One record per page&#10;Keep doc, page, course, level&#10;PII regex redaction&#10;Mark non-indexable pages&#10;(kept for citation lookup)&#10;prepared_text.jsonl" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="774" y="118" width="220" height="176" as="geometry"/></mxCell><mxCell id="c4" value="Non-empty, read-back equal&#10;Unique record IDs&#10;Every record has a page&#10;Records = pages per source&#10;No PII patterns remain&#10;Stop on any failure" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1022" y="118" width="220" height="176" as="geometry"/></mxCell><mxCell id="c5" value="SHA-256 per source and output&#10;Source-to-output mapping&#10;data/week3_manifest.json&#10;pipeline_v1/course_documents/&#10;pipeline_manifest.json&#10;Rerun must match" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1270" y="118" width="220" height="176" as="geometry"/></mxCell><mxCell id="i0" value="Data Source 2: HRD Corp IndSF&#10;data/industry_benchmark/&#10;2 PDFs&#10;Data Science and AI&#10;FR7" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="330" width="220" height="176" as="geometry"/></mxCell><mxCell id="i1" value="Integrity check:&#10;PDF end marker&#10;Native text + RapidOCR&#10;Conditional OCR on sparse&#10;or image-heavy pages&#10;Document cache disabled" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="278" y="330" width="220" height="176" as="geometry"/></mxCell><mxCell id="i2" value="49 pages, counted per file&#10;OCR and empty-page counts&#10;Redaction event counts&#10;Structured items by section" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="526" y="330" width="220" height="176" as="geometry"/></mxCell><mxCell id="i3" value="One record per page&#10;Stage B1 structured items&#10;(tasks, skills, competencies,&#10;tools, SFIA levels)&#10;No embeddings&#10;prepared_indsf_*.jsonl" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="774" y="330" width="220" height="176" as="geometry"/></mxCell><mxCell id="i4" value="Non-empty, read-back equal&#10;Unique record IDs&#10;Every page record has a page&#10;Records = pages per source&#10;No PII patterns remain&#10;Stop on any failure" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1022" y="330" width="220" height="176" as="geometry"/></mxCell><mxCell id="i5" value="SHA-256 per source and output&#10;Source-to-output mapping&#10;data/week3_manifest.json&#10;pipeline_v1/indsf_documents/&#10;pipeline_manifest.json&#10;Rerun must match" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1270" y="330" width="220" height="176" as="geometry"/></mxCell><mxCell id="f1" value="Failure point 1 (both branches): truncated or corrupt source file&#10;A repaired PDF can open with silently blank pages.&#10;Response: stop at INGEST, name the file, write no prepared data." style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="278" y="550" width="468" height="96" as="geometry"/></mxCell><mxCell id="f2" value="Failure point 2 (both branches): prepared output no longer matches its hash&#10;A later edit or stale file breaks lineage.&#10;Response: stop verification and report the file; re-run the pipeline." style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1022" y="550" width="468" height="96" as="geometry"/></mxCell><mxCell id="later" value="Prepared data feeds later stages, not part of this lab: embeddings and routed indexes, retrieval, B200 model judgement, citation verification, dashboard.&#10;Prepared course records stay local because they hold full course text; IndSF records, manifests, notebook and docs are committed." style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#F5F5F5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="680" width="1460" height="74" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#444444;endArrow=block;" edge="1" parent="1" source="c0" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#444444;endArrow=block;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#444444;endArrow=block;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#444444;endArrow=block;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#444444;endArrow=block;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#444444;endArrow=block;" edge="1" parent="1" source="i0" target="i1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#444444;endArrow=block;" edge="1" parent="1" source="i1" target="i2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#444444;endArrow=block;" edge="1" parent="1" source="i2" target="i3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#444444;endArrow=block;" edge="1" parent="1" source="i3" target="i4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#444444;endArrow=block;" edge="1" parent="1" source="i4" target="i5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;strokeColor=#B85450;endArrow=block;" edge="1" parent="1" source="i1" target="f1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" style="edgeStyle=orthogo